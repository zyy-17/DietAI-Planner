# ══════════════════════════════════════════════════════════════════
#  DietAI AI 服务配置
#  复制本文件为 .env（同目录），把 API_KEY 换成你自己的即可。
#  .env 已在 .gitignore 里，不会被提交到 GitHub。
# ══════════════════════════════════════════════════════════════════

# ── 用哪套后端 ────────────────────────────────────────────────────
#   api     = 走云端大模型 API（推荐，快、稳、不用本地跑模型）
#   ollama  = 走本机 Ollama
#   auto    = 填了 API_KEY 就用 api，没填就用 ollama
LLM_BACKEND=auto


# ── 云端 API（OpenAI 兼容，任选一家填） ───────────────────────────
# 下面 4 组配置「任选一组」，取消注释并填好自己的 key 即可。

# 【方案 1】DeepSeek（便宜、中文好、最省事）
API_KEY=
API_BASE_URL=https://api.deepseek.com/v1
API_MODEL=deepseek-chat

# 【方案 2】火山方舟 / 豆包（国内速度快）
#   注意 API_BASE_URL 不同：/api/v3，不是 /v1
# API_KEY=
# API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# API_MODEL=doubao-seed-1-6-250615

# 【方案 3】阿里云百炼 / 通义千问
# API_KEY=
# API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API_MODEL=qwen-plus

# 【方案 4】智谱 GLM / Kimi 等其他 OpenAI 兼容接口
# API_KEY=
# API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# API_MODEL=glm-4-flash
# 或者 Kimi：
# API_BASE_URL=https://api.moonshot.cn/v1
# API_MODEL=moonshot-v1-8k


# ── 调参（一般不用改） ────────────────────────────────────────────
API_TEMPERATURE=0.6
API_MAX_TOKENS=2048
# 单次请求等待上限（秒）
API_TIMEOUT=120


# ── 本机 Ollama（LLM_BACKEND=ollama 时才用） ──────────────────────
OLLAMA_HOST=http://localhost:11434


# ── 服务监听地址（一般不用改） ────────────────────────────────────
# 默认只听 127.0.0.1。本服务没有鉴权，改成 0.0.0.0 会让同局域网的人
# 也能调用你的 AI 接口并消耗你的 API 额度，仅在确有需要时才改。
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
